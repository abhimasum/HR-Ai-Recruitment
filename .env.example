# Database
DATABASE_URL=postgresql+asyncpg://hr:hr@localhost:5432/hr
AUTH_SIGNING_KEY=
AUTH_COOKIE_SECURE=false

# Choose AI Provider: "openai" or "vertexai"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-key

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# GCP Vertex AI Configuration (Used when LLM_PROVIDER=vertexai or EMBEDDING_PROVIDER=vertexai)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# For Vertex AI, set:
# LLM_PROVIDER=vertexai
# LLM_MODEL=gemini-1.5-flash
# EMBEDDING_PROVIDER=vertexai
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIM=768

# Screening Decision Thresholds (80% / 60-80% / <60%)
ACCEPT_THRESHOLD=80
REJECT_THRESHOLD=60

# CORS (Comma-separated origins or * for all)
CORS_ORIGINS=http://localhost:5173
